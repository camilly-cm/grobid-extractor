# Copy to .env and adjust. Values here are the defaults used by the code.

# Where the GROBID server (docker compose) is listening
GROBID_URL=http://localhost:8070

# Seconds to wait for a single PDF to be processed
GROBID_TIMEOUT=180

# Number of PDFs sent in parallel (keep <= GROBID server threads; 2-6 is safe on a laptop)
GROBID_CONCURRENCY=4

# Retries when the server answers 503 (busy)
GROBID_MAX_RETRIES=5

# Host port and memory limit used by docker-compose.yml
GROBID_PORT=8070
GROBID_MEM_LIMIT=4g
